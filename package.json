{
  "name": "dicehall",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --external:next --external:express --external:socket.io",
    "start": "node server.js",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "proxy-addr": "^2.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^4.1.12"
  }
}
